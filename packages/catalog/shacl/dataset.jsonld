{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "schema": "http://schema.org/",
    "sh": "http://www.w3.org/ns/shacl#",
    "vtn": "https://termennetwerk.meemoo.be/ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "schema:Dataset"
      },
      "sh:property": [
        {
          "sh:path": {
            "@id": "schema:name"
          },
          "sh:datatype": {
            "@id": "rdf:langString"
          },
          "sh:uniqueLang": true,
          "sh:minCount": 1
        },
        {
          "sh:path": {
            "@id": "schema:alternateName"
          },
          "sh:datatype": {
            "@id": "rdf:langString"
          },
          "sh:uniqueLang": true,
          "sh:minCount": 0
        },
        {
          "sh:path": {
            "@id": "schema:genre"
          },
          "sh:minCount": 1,
          "sh:pattern": "^https://data.cultureelerfgoed.nl/termennetwerk/onderwerpen/"
        },
        {
          "sh:path": {
            "@id": "schema:inLanguage"
          },
          "sh:minCount": 1
        },
        {
          "sh:path": {
            "@id": "schema:mainEntityOfPage"
          },
          "sh:minCount": 1,
          "sh:nodeKind": {
            "@id": "sh:IRI"
          }
        },
        {
          "sh:path": {
            "@id": "schema:url"
          },
          "sh:nodeKind": {
            "@id": "sh:IRI"
          }
        },
        {
          "sh:path": {
            "@id": "schema:distribution"
          },
          "sh:minCount": 1,
          "sh:class": {
            "@id": "schema:DataDownload"
          },
          "sh:node": "schema:DistributionShape",
          "sh:nodeKind": {
            "@id": "sh:IRI"
          }
        },
        {
          "sh:path": {
            "@id": "schema:creator"
          },
          "sh:minCount": 1,
          "sh:class": {
            "@id": "schema:Organization"
          },
          "sh:node": "schema:CreatorShape"
        },
        {
          "sh:path": {
            "@id": "schema:description"
          },
          "sh:datatype": {
            "@id": "rdf:langString"
          },
          "sh:uniqueLang": true,
          "sh:minCount": 1
        },
        {
          "sh:path": {
            "@id": "vtn:resultType"
          },
          "sh:in": {
            "@list": ["concept", "person", "organization", "place", "event"]
          },
          "sh:description": "Central result types this source yields. Omit when the source does not know; then each result's type is derived from its rdf:type."
        },
        {
          "sh:path": {
            "@id": "vtn:typeMapping"
          },
          "sh:node": "vtn:TypeMappingShape",
          "sh:nodeKind": {
            "@id": "sh:BlankNodeOrIRI"
          },
          "sh:description": "Rules mapping the source's own classes to central result types."
        }
      ]
    },
    {
      "@id": "schema:DistributionShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "schema:DataDownload"
      },
      "sh:property": [
        {
          "sh:path": {
            "@id": "schema:contentUrl"
          },
          "sh:minCount": 1
        },
        {
          "sh:path": {
            "@id": "schema:encodingFormat"
          },
          "sh:hasValue": "application/sparql-query"
        },
        {
          "sh:path": {
            "@id": "schema:potentialAction"
          },
          "sh:qualifiedValueShape": {
            "sh:class": {
              "@id": "schema:SearchAction"
            }
          },
          "sh:qualifiedMinCount": 1,
          "sh:qualifiedMaxCount": 1
        },
        {
          "sh:path": {
            "@id": "schema:potentialAction"
          },
          "sh:qualifiedValueShape": {
            "sh:class": {
              "@id": "schema:FindAction"
            }
          },
          "sh:qualifiedMinCount": 1,
          "sh:qualifiedMaxCount": 1
        },
        {
          "sh:path": {
            "@id": "schema:potentialAction"
          },
          "sh:qualifiedValueShape": {
            "sh:class": {
              "@id": "schema:Action"
            }
          },
          "sh:qualifiedMinCount": 0
        },
        {
          "sh:path": {
            "@id": "vtn:timeoutMs"
          },
          "sh:datatype": {
            "@id": "xsd:integer"
          },
          "sh:minInclusive": 1,
          "sh:maxCount": 1,
          "sh:description": "Optional per-source timeout in milliseconds; the query engine uses the smaller of this value and the request timeout."
        },
        {
          "sh:path": {
            "@id": "schema:potentialAction"
          },
          "sh:qualifiedValueShape": {
            "sh:class": {
              "@id": "vtn:BrowseAction"
            },
            "sh:property": [
              {
                "sh:path": {
                  "@id": "schema:query"
                },
                "sh:minCount": 1,
                "sh:maxCount": 1
              }
            ]
          },
          "sh:qualifiedMinCount": 0,
          "sh:qualifiedMaxCount": 1,
          "sh:description": "Optional browse template for hierarchical navigation (concept sources only)."
        }
      ]
    },
    {
      "@id": "schema:CreatorShape",
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "schema:Organization"
      },
      "sh:property": [
        {
          "sh:path": {
            "@id": "schema:name"
          },
          "sh:datatype": {
            "@id": "rdf:langString"
          },
          "sh:uniqueLang": true,
          "sh:minCount": 1
        },
        {
          "sh:path": {
            "@id": "schema:alternateName"
          },
          "sh:minCount": 1
        }
      ]
    },
    {
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "schema:SearchAction"
      },
      "sh:property": [
        {
          "sh:path": {
            "@id": "schema:query"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        }
      ]
    },
    {
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "schema:FindAction"
      },
      "sh:property": [
        {
          "sh:path": {
            "@id": "schema:query"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        }
      ]
    },
    {
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "schema:Action"
      },
      "sh:property": [
        {
          "sh:path": {
            "@id": "schema:target"
          },
          "sh:class": {
            "@id": "schema:EntryPoint"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        }
      ]
    },
    {
      "@type": "sh:NodeShape",
      "sh:targetClass": {
        "@id": "schema:EntryPoint"
      },
      "sh:property": [
        {
          "sh:path": {
            "@id": "schema:actionApplication"
          },
          "sh:class": {
            "@id": "schema:SoftwareApplication"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": {
            "@id": "schema:urlTemplate"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        }
      ]
    },
    {
      "@id": "vtn:TypeMappingShape",
      "@type": "sh:NodeShape",
      "sh:property": [
        {
          "sh:path": {
            "@id": "vtn:sourceType"
          },
          "sh:nodeKind": {
            "@id": "sh:IRI"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": {
            "@id": "vtn:resultType"
          },
          "sh:in": {
            "@list": ["concept", "person", "organization", "place", "event"]
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        }
      ]
    }
  ]
}

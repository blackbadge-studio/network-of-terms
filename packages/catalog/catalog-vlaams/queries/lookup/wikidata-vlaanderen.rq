PREFIX hint: <http://www.bigdata.com/queryHints#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

CONSTRUCT {
    ?uri a skos:Concept, ?type ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:scopeNote ?description ;
        skos:exactMatch ?viaf ;
        rdfs:seeAlso ?odis .
}
WHERE {
    # With the optimizer off the patterns run as written, from the given URIs. Left to itself
    # Blazegraph starts the type checks at the classes and scans every human in Wikidata.
    hint:Query hint:optimizer "None" .

    # For example:
    # Person: <http://www.wikidata.org/entity/Q5599> (Rubens)
    # Place: <http://www.wikidata.org/entity/Q12990> (Ieper)
    VALUES ?uri { ?uris }

    # ‘mul’ is Wikidata’s ‘default for all languages’ label.
    ?uri rdfs:label ?prefLabel .
    FILTER(LANG(?prefLabel) IN ("nl", "en", "mul"))

    # One UNION branch per independently multi-valued property, and not an OPTIONAL group:
    # see “One UNION branch per multi-valued property” in the catalog README.
    {
        { ?uri rdfs:label ?prefLabel }
        UNION {
            ?uri skos:altLabel ?altLabel .
            FILTER(LANG(?altLabel) IN ("nl", "en", "mul"))
        }
        UNION {
            ?uri schema:description ?description .
            FILTER(LANG(?description) IN ("nl", "en"))
        }
        # The type, by the same rule as the search template (wikidata-alle-entiteiten.rq), so a term
        # is of the same type whether it was searched for or looked up: what the item is an
        # instance of, up to six subclass steps away, is human (Q5), else geographic location
        # (Q2221906), else organization (Q43229), else occurrence (Q1190554); what is none of
        # these stays a concept. A person is settled by the first branch alone: walking up from
        # ‘human’ for the other three took five to ten seconds per lookup. The paths have a fixed
        # number of steps and not wdt:P279*, which Blazegraph runs many times slower.
        UNION {
            ?uri wdt:P31 wd:Q5 .
            BIND(schema:Person AS ?type)
        }
        UNION {
            ?uri wdt:P31 ?class .
            FILTER NOT EXISTS { ?uri wdt:P31 wd:Q5 }
            FILTER EXISTS { ?uri (wdt:P31|wdt:P31/wdt:P279|wdt:P31/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279) wd:Q2221906 }
            BIND(schema:Place AS ?type)
        }
        UNION {
            ?uri wdt:P31 ?class .
            FILTER NOT EXISTS { ?uri wdt:P31 wd:Q5 }
            FILTER NOT EXISTS { ?uri (wdt:P31|wdt:P31/wdt:P279|wdt:P31/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279) wd:Q2221906 }
            FILTER EXISTS { ?uri (wdt:P31|wdt:P31/wdt:P279|wdt:P31/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279) wd:Q43229 }
            BIND(schema:Organization AS ?type)
        }
        UNION {
            ?uri wdt:P31 ?class .
            FILTER NOT EXISTS { ?uri wdt:P31 wd:Q5 }
            FILTER NOT EXISTS { ?uri (wdt:P31|wdt:P31/wdt:P279|wdt:P31/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279) wd:Q2221906 }
            FILTER NOT EXISTS { ?uri (wdt:P31|wdt:P31/wdt:P279|wdt:P31/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279) wd:Q43229 }
            FILTER EXISTS { ?uri (wdt:P31|wdt:P31/wdt:P279|wdt:P31/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279|wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279) wd:Q1190554 }
            BIND(schema:Event AS ?type)
        }
        UNION {
            ?uri wdt:P214 ?viafId .
            BIND(IRI(CONCAT("https://viaf.org/viaf/", ?viafId)) AS ?viaf)
        }
        UNION {
            ?uri wdt:P2372 ?odisId .
            BIND(IRI(CONCAT("https://www.odis.be/lnk/", ?odisId)) AS ?odis)
        }
    }
}
LIMIT 10000

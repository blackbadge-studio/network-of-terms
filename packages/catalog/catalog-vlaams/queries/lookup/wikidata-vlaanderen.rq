PREFIX hint: <http://www.bigdata.com/queryHints#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

CONSTRUCT {
    ?uri a skos:Concept, ?type ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:scopeNote ?description ;
        skos:exactMatch ?viaf ;
        rdfs:seeAlso ?odis .
}
WHERE {
    # For example:
    # Person: <http://www.wikidata.org/entity/Q5599> (Rubens)
    # Place: <http://www.wikidata.org/entity/Q12990> (Ieper)
    {
        SELECT ?uri ?type WHERE {
            {
                SELECT ?uri (COALESCE(MAX(?rank), 0) AS ?best) WHERE {
                    # With the optimizer off the patterns run as written, from the given URIs.
                    # Left to itself Blazegraph starts at the classes and scans every human in
                    # Wikidata.
                    hint:Query hint:optimizer "None" .
                    VALUES ?uri { ?uris }

                    # ‘mul’ is Wikidata’s ‘default for all languages’ label. A plain pattern and
                    # not FILTER EXISTS: Blazegraph runs that filter before it knows the URIs.
                    ?uri rdfs:label ?label .
                    FILTER(LANG(?label) IN ("nl", "en", "mul"))

                    # The same check as in the search template (wikidata-alle-entiteiten.rq), so
                    # a term is of the same type whether it was searched for or looked up.
                    OPTIONAL {
                        VALUES (?class ?rank) {
                            (wd:Q5 4)
                            (wd:Q2221906 3)
                            (wd:Q43229 2)
                            (wd:Q1190554 1)
                        }
                        { ?uri wdt:P31 ?class . }
                        UNION { ?uri wdt:P31/wdt:P279 ?class . }
                        UNION { ?uri wdt:P31/wdt:P279/wdt:P279 ?class . }
                        UNION { ?uri wdt:P31/wdt:P279/wdt:P279/wdt:P279 ?class . }
                        UNION { ?uri wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279 ?class . }
                        UNION { ?uri wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279 ?class . }
                        UNION { ?uri wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279 ?class . }
                    }
                }
                GROUP BY ?uri
            }
            VALUES (?best ?type) {
                (4 schema:Person)
                (3 schema:Place)
                (2 schema:Organization)
                (1 schema:Event)
                (0 skos:Concept)
            }
        }
    }

    # One UNION branch per independently multi-valued property, and not an OPTIONAL group:
    # see “One UNION branch per multi-valued property” in the catalog README.
    {
        {
            ?uri rdfs:label ?prefLabel .
            FILTER(LANG(?prefLabel) IN ("nl", "en", "mul"))
        }
        UNION {
            ?uri skos:altLabel ?altLabel .
            FILTER(LANG(?altLabel) IN ("nl", "en", "mul"))
        }
        UNION {
            ?uri schema:description ?description .
            FILTER(LANG(?description) IN ("nl", "en"))
        }
        UNION {
            ?uri wdt:P214 ?viafId .
            BIND(IRI(CONCAT("https://viaf.org/viaf/", ?viafId)) AS ?viaf)
        }
        UNION {
            ?uri wdt:P2372 ?odisId .
            BIND(IRI(CONCAT("https://www.odis.be/lnk/", ?odisId)) AS ?odis)
        }
    }
}
LIMIT 10000

PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

CONSTRUCT {
    ?uri a skos:Concept, ?type ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:scopeNote ?description ;
        skos:exactMatch ?viaf ;
        rdfs:seeAlso ?odis .
}
WHERE {
    # For example:
    # Person: <http://www.wikidata.org/entity/Q5599> (Rubens)
    # Place: <http://www.wikidata.org/entity/Q12990> (Ieper)
    VALUES ?uri { ?uris }

    # ‘mul’ is Wikidata’s ‘default for all languages’ label.
    ?uri rdfs:label ?prefLabel .
    FILTER(LANG(?prefLabel) IN ("nl", "en", "mul"))

    # One UNION branch per independently multi-valued property, and not an OPTIONAL group:
    # see “One UNION branch per multi-valued property” in the catalog README.
    {
        { ?uri rdfs:label ?prefLabel }
        UNION {
            ?uri skos:altLabel ?altLabel .
            FILTER(LANG(?altLabel) IN ("nl", "en", "mul"))
        }
        UNION {
            ?uri schema:description ?description .
            FILTER(LANG(?description) IN ("nl", "en"))
        }
        UNION {
            ?uri wdt:P31 wd:Q5 .
            BIND(schema:Person AS ?type)
        }
        UNION {
            ?uri wdt:P31/wdt:P279* wd:Q486972 .
            BIND(schema:Place AS ?type)
        }
        UNION {
            ?uri wdt:P214 ?viafId .
            BIND(IRI(CONCAT("https://viaf.org/viaf/", ?viafId)) AS ?viaf)
        }
        UNION {
            ?uri wdt:P2372 ?odisId .
            BIND(IRI(CONCAT("https://www.odis.be/lnk/", ?odisId)) AS ?odis)
        }
    }
}
LIMIT 10000

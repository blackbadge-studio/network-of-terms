PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX gschema: <http://schema.org/>
PREFIX gvp: <http://vocab.getty.edu/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX skosxl: <http://www.w3.org/2008/05/skos-xl#>

CONSTRUCT {
    ?uri a skos:Concept, ?type, ?schemaType ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:scopeNote ?biography ;
        rdfs:seeAlso ?rdfs_seeAlso ;
        skos:exactMatch ?exactMatch_uri ;
        schema:birthDate ?start ;
        schema:deathDate ?end ;
        schema:nationality ?nationality ;
        schema:gender ?gender .
}
WHERE {
    # For example: Rubens <http://vocab.getty.edu/ulan/500018960>
    VALUES ?uri { ?uris }
    ?uri a ?type .
    VALUES ?type { gvp:PersonConcept gvp:GroupConcept }
    BIND(IF(?type = gvp:PersonConcept, schema:Person, schema:Organization) AS ?schemaType)
    {
        { ?uri gvp:prefLabelGVP/skosxl:literalForm ?prefLabel . }
        UNION { ?uri skosxl:altLabel/skosxl:literalForm ?altLabel . }
        UNION { ?uri foaf:focus/gvp:biographyPreferred/gschema:description ?biography . }
        UNION { ?uri rdfs:seeAlso ?rdfs_seeAlso . }
        UNION {
            ?uri skos:exactMatch ?exactMatch_uri .
            FILTER(?exactMatch_uri != ?uri)
        }
        UNION { ?uri foaf:focus/gvp:biographyPreferred/gvp:estStart ?start . }
        UNION { ?uri foaf:focus/gvp:biographyPreferred/gvp:estEnd ?end . }
        UNION { ?uri foaf:focus/gvp:nationalityPreferred/gvp:prefLabelGVP/skosxl:literalForm ?nationality . }
        UNION { ?uri foaf:focus/gschema:gender/gvp:prefLabelGVP/skosxl:literalForm ?gender . }
    }
}
LIMIT 10000

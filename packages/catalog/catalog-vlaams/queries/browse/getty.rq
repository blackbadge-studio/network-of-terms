PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX gvp: <http://vocab.getty.edu/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX skosxl: <http://www.w3.org/2008/05/skos-xl#>

# Browse template for the Getty vocabularies (AAT, TGN). ?parent is a concept, or the dataset for
# the top level (the scheme is the dataset IRI with a trailing slash, e.g. http://vocab.getty.edu/aat/).
# Getty has no skos:hasTopConcept: the top level is the scheme's facets (AAT: Objects Facet,
# Materials Facet, …; TGN: World, Extraterrestrial Places, …).
# Children follow gvp:broader, which includes non-preferred parents: Getty's polyhierarchy is kept,
# and every node lists all its broader concepts.
CONSTRUCT {
    ?uri a skos:Concept ;
        skos:prefLabel ?prefLabel ;
        skos:broader ?broader_uri ;
        skos:narrower ?child .
    ?broader_uri skos:prefLabel ?broader_prefLabel .
}
WHERE {
    {
        SELECT DISTINCT ?uri WHERE {
            {
                # Getty has fifteen facets in all; matching on the IRI is much faster here than
                # joining on a scheme IRI that is computed from ?parent.
                ?uri a gvp:Facet .
                FILTER(STRSTARTS(STR(?uri), CONCAT(STR(?parent), "/")))
            }
            UNION { ?uri gvp:broader ?parent }
        }
        #LIMIT#
    }
    {
        { ?uri gvp:prefLabelGVP/skosxl:literalForm ?prefLabel }
        UNION {
            ?uri gvp:broader ?broader_uri .
            ?broader_uri gvp:prefLabelGVP/skosxl:literalForm ?broader_prefLabel .
        }
        UNION {
            # Whether the node can be expanded. Getty nodes can have thousands of children, so this
            # does not fetch them: a node that has any gets itself as a marker in skos:narrower,
            # which is all the tree reads (it asks for the children when the node is opened).
            FILTER EXISTS { ?c gvp:broader ?uri }
            BIND(?uri AS ?child)
        }
    }
}

PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX hint: <http://www.bigdata.com/queryHints#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vrank: <http://purl.org/voc/vrank#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>

# Wikidata without restriction, for terms that no other source covers. The source is mixed, so
# the template itself says of every hit which of the five result types it is, and keeps only the
# genres that were asked for (GENRE_FILTER).
CONSTRUCT {
    ?item a skos:Concept, ?type ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:scopeNote ?description ;
        skos:exactMatch ?viaf ;
        rdfs:seeAlso ?odis ;
        vrank:simpleRank ?score .
}
WHERE {
    {
        SELECT ?item ?score ?type WHERE {
            {
                SELECT ?item ?score (COALESCE(MAX(?rank), 0) AS ?best) WHERE {
                    # Blazegraph otherwise reorders the class check before the search service and
                    # scans millions of items; with the optimizer off the patterns run as written.
                    hint:Query hint:optimizer "None" .
                    SERVICE wikibase:mwapi {
                        bd:serviceParam wikibase:endpoint "www.wikidata.org" ;
                            wikibase:api "Search" ;
                            wikibase:limit "once" ;
                            mwapi:language "nl" ;
                            # The best hundred hits are classified. Unbounded, the search hands
                            # over five hundred, and classifying those takes five to nine seconds.
                            mwapi:srlimit "100" ;
                            mwapi:srsearch ?query .
                        ?item wikibase:apiOutputItem mwapi:title .
                        ?ordinal wikibase:apiOrdinal true.
                    }
                    BIND(-?ordinal AS ?score)

                    # ‘mul’ is Wikidata’s ‘default for all languages’ label.
                    FILTER EXISTS {
                        ?item rdfs:label ?prefLabel .
                        FILTER(LANG(?prefLabel) IN ("nl", "en", "mul"))
                    }

                    # What the item is an instance of, up to six subclass steps away: human (Q5),
                    # geographic location (Q2221906), organization (Q43229), occurrence (Q1190554).
                    # A fixed number of steps and not wdt:P279*: Blazegraph runs these as plain
                    # joins, where the open-ended path took five to thirteen seconds per search.
                    OPTIONAL {
                        VALUES (?class ?rank) {
                            (wd:Q5 4)
                            (wd:Q2221906 3)
                            (wd:Q43229 2)
                            (wd:Q1190554 1)
                        }
                        { ?item wdt:P31 ?class . }
                        UNION { ?item wdt:P31/wdt:P279 ?class . }
                        UNION { ?item wdt:P31/wdt:P279/wdt:P279 ?class . }
                        UNION { ?item wdt:P31/wdt:P279/wdt:P279/wdt:P279 ?class . }
                        UNION { ?item wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279 ?class . }
                        UNION { ?item wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279 ?class . }
                        UNION { ?item wdt:P31/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279/wdt:P279 ?class . }
                    }
                }
                GROUP BY ?item ?score
            }

            # One type per item, the highest rank it reaches: a municipality is an organization
            # too in Wikidata’s class tree, and is a place here. What reaches none is a concept.
            VALUES (?best ?genreUri ?type) {
                (4 <https://termennetwerk.meemoo.be/genres/persoon> schema:Person)
                (3 <https://termennetwerk.meemoo.be/genres/plaats> schema:Place)
                (2 <https://termennetwerk.meemoo.be/genres/organisatie> schema:Organization)
                (1 <https://termennetwerk.meemoo.be/genres/gebeurtenis> schema:Event)
                (0 <https://termennetwerk.meemoo.be/genres/concept> skos:Concept)
            }
            VALUES ?genreUri { ?genres }
        }
        ORDER BY DESC(?score)
        #LIMIT#
    }

    # One UNION branch per independently multi-valued property, and not an OPTIONAL group:
    # see “One UNION branch per multi-valued property” in the catalog README.
    {
        {
            ?item rdfs:label ?prefLabel .
            FILTER(LANG(?prefLabel) IN ("nl", "en", "mul"))
        }
        UNION {
            ?item skos:altLabel ?altLabel .
            FILTER(LANG(?altLabel) IN ("nl", "en", "mul"))
        }
        UNION {
            ?item schema:description ?description .
            FILTER(LANG(?description) IN ("nl", "en"))
        }
        UNION {
            # VIAF is in the tender but has no SPARQL endpoint; its identifier travels along as an
            # exact match so clients get the VIAF URI with every person.
            ?item wdt:P214 ?viafId .
            BIND(IRI(CONCAT("https://viaf.org/viaf/", ?viafId)) AS ?viaf)
        }
        UNION {
            ?item wdt:P2372 ?odisId .
            BIND(IRI(CONCAT("https://www.odis.be/lnk/", ?odisId)) AS ?odis)
        }
    }
}

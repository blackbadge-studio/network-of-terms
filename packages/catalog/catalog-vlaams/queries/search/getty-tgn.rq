PREFIX aat: <http://vocab.getty.edu/aat/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX gschema: <http://schema.org/>
PREFIX gvp: <http://vocab.getty.edu/ontology#>
PREFIX luc: <http://www.ontotext.com/owlim/lucene#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX skosxl: <http://www.w3.org/2008/05/skos-xl#>
PREFIX void: <http://rdfs.org/ns/void#>

# TGN: places. The preferred place type becomes the place's additionalType and the preferred
# parent its broader term, so the hierarchy (Ieper → West-Vlaanderen → België) is navigable.
CONSTRUCT {
    ?uri a skos:Concept, schema:Place ;
        skos:prefLabel ?prefLabel ;
        skos:altLabel ?altLabel ;
        skos:scopeNote ?scopeNote ;
        rdfs:seeAlso ?rdfs_seeAlso ;
        skos:broader ?broader_uri ;
        schema:latitude ?lat ;
        schema:longitude ?long ;
        schema:additionalType ?placeType_uri .
    ?broader_uri skos:prefLabel ?broader_prefLabel .
    ?placeType_uri schema:name ?placeType_name .
}
WHERE {
    VALUES ?language {
        aat:300388256 # Dutch
        aat:300388277 # English
    }
    {
        SELECT DISTINCT ?uri WHERE {
            ?uri luc:term ?query ;
                a ?type ;
                void:inDataset <http://vocab.getty.edu/dataset/tgn> .
            VALUES ?type { gvp:AdminPlaceConcept gvp:PhysPlaceConcept }
        }
        #LIMIT#
    }

    # One UNION branch per independently multi-valued property, and not an OPTIONAL group:
    # see “One UNION branch per multi-valued property” in the catalog README.
    {
        { ?uri gvp:prefLabelGVP/skosxl:literalForm ?prefLabel . }
        UNION {
            ?uri skosxl:altLabel [
                dcterms:language ?language ;
                skosxl:literalForm ?altLabel
            ]
        }
        UNION {
            ?uri skos:scopeNote [
                dcterms:language ?language ;
                rdf:value ?scopeNote
            ]
        }
        UNION { ?uri rdfs:seeAlso ?rdfs_seeAlso . }
        UNION {
            ?uri gvp:broaderPreferred ?broader_uri .
            ?broader_uri gvp:prefLabelGVP/skosxl:literalForm ?broader_prefLabel .
        }
        UNION { ?uri foaf:focus/gschema:lat ?lat . }
        UNION { ?uri foaf:focus/gschema:long ?long . }
        UNION {
            ?uri gvp:placeTypePreferred ?placeType_uri .
            ?placeType_uri gvp:prefLabelGVP/skosxl:literalForm ?placeType_name .
        }
    }
}

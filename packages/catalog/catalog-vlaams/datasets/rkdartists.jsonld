  "description": [
    {
      "@language": "en",
      "@value": "Biographical data of artists from the Low Countries and abroad, from the Middle Ages to the present, including the Flemish masters"
    },
    {
      "@language": "nl",
      "@value": "Biografische gegevens van kunstenaars uit de Lage Landen en daarbuiten, van de middeleeuwen tot heden, met onder meer de Vlaamse meesters"

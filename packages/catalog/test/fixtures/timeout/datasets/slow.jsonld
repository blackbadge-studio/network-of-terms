  "@id": "https://example.org/slow",
  "@type": "Dataset",
  "name": [{ "@language": "nl", "@value": "Trage bron" }],
  "description": [
    {
      "@language": "nl",
      "@value": "Een bron met een eigen timeout in de catalogus"
    }
  ],
  "genre": [
    {
      "@id": "https://data.cultureelerfgoed.nl/termennetwerk/onderwerpen/Objecten"
    }
  ],

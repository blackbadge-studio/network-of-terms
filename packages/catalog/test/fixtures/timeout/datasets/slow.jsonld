    {
      "@id": "https://example.org/",
      "@type": "Organization",
      "name": "Example",
      "alternateName": "EX"
    }
  ],
  "url": ["https://example.org/slow/"],
  "mainEntityOfPage": ["https://example.org/slow/about"],
  "inLanguage": "nl",
  "distribution": [
    {
      "@id": "https://example.org/slow/sparql",
      "@type": "DataDownload",
